[Unit]
Description=PT315-53 automatic fan controller
# Count starts for the unit's whole lifetime. A start-limit hit leaves the runtime fault latch
# failed until an operator explicitly resets it.
StartLimitIntervalSec=infinity
StartLimitBurst=2
# The sleep guard owns this gate from preparation through the authorized resume start.
ConditionPathExists=!/run/pt31553-fan-sleep-guard/resume-daemon-start-blocked

[Service]
Type=notify
NotifyAccess=main
RuntimeDirectory=pt31553-fan-control
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/pt31553-fand
ExecStopPost=/usr/bin/pt31553-fan-restore --restore
WatchdogSec=6s
Restart=on-failure
RestartSec=2s
# Qualified startup may consume two full sample windows plus the bounded tachometer-response
# window. Leave recovery margin so systemd does not kill a valid admission attempt.
TimeoutStartSec=30s
# Recovery owns the restart gate and retries until Firmware Auto is confirmed.
TimeoutStopSec=infinity
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
# GPU temperature sampling needs the NVIDIA control and sole supported GPU nodes. Keep every
# other device denied through the closed device policy.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia0 rw
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadWritePaths=/sys/class/hwmon /run/pt31553-fan-control

[Install]
WantedBy=multi-user.target
# Enabling Custom control must also install the required guard on every system sleep path.
Also=pt31553-fan-sleep-guard.service
