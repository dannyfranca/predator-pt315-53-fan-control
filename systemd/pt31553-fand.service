[Unit]
Description=PT315-53 automatic fan controller
# Count starts for the unit's whole lifetime. A start-limit hit leaves the runtime fault latch
# failed until an operator explicitly resets it.
StartLimitIntervalSec=infinity
StartLimitBurst=2
# The sleep guard owns this gate from preparation through the authorized resume start.
ConditionPathExists=!/run/pt31553-fan-sleep-guard/resume-daemon-start-blocked

[Service]
Type=notify
NotifyAccess=main
RuntimeDirectory=pt31553-fan-control
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/pt31553-fand
ExecStopPost=/usr/bin/pt31553-fan-restore --restore
WatchdogSec=6s
Restart=on-failure
RestartSec=2s
TimeoutStartSec=6s
# Recovery owns the restart gate and retries until Firmware Auto is confirmed.
TimeoutStopSec=infinity
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadWritePaths=/sys/class/hwmon /run/pt31553-fan-control
