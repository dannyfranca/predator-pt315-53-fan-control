[Unit]
Description=PT315-53 fan safety guard for system sleep
# All systemd suspend and hibernation services cross sleep.target. Making this guard a required,
# ordered dependency turns an unsuccessful restoration command into a failed sleep transaction.
Before=sleep.target
StopWhenUnneeded=yes

[Service]
Type=oneshot
# Preparation records a healthy running daemon, stops it synchronously, then retries restoration and
# safe containment until both fans confirm Auto. Its successful exit is the sleep permission boundary.
ExecStart=/usr/bin/pt31553-fan-restore --prepare-sleep
TimeoutStartSec=infinity
RemainAfterExit=yes
# Only a daemon deliberately stopped above is resumed. The helper safely clears its planned-start
# counter first; a pre-existing fault latch remains stopped. A fresh process must fully rearm.
ExecStop=/usr/bin/pt31553-fan-restore --resume-after-sleep
# ExecStop is skipped when preparation never completed. ExecStopPost checks the root-only marker
# written only after Auto confirmation, and keeps independent recovery alive if it is absent.
ExecStopPost=/usr/bin/pt31553-fan-restore --restore-after-failed-sleep-guard
TimeoutStopSec=infinity
# Create both private runtime roots before the strict mount namespace is assembled. Preserve them
# across stop/failure so systemd cannot erase the daemon start gate after a failed transaction.
RuntimeDirectory=pt31553-fan-control pt31553-fan-sleep-guard
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadWritePaths=/sys/class/hwmon /run/pt31553-fan-control /run/pt31553-fan-sleep-guard

[Install]
RequiredBy=sleep.target
