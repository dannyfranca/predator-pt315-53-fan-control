{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dannyfranca/predator-pt315-53-fan-control/schemas/promotion-manifest.json",
  "title": "PT315-53 qualified artifact promotion manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_record_sha256",
    "controller",
    "policy",
    "kernel",
    "packages",
    "sanitized_evidence_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "qualification_record_sha256": { "$ref": "#/$defs/sha256" },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_sha256", "signature_sha256"],
      "properties": {
        "package_sha256": { "$ref": "#/$defs/sha256" },
        "signature_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "image_sha256",
        "image_signer_fingerprint",
        "module_sha256",
        "module_signer_fingerprint"
      ],
      "properties": {
        "release": { "type": "string", "minLength": 1, "maxLength": 128 },
        "image_sha256": { "$ref": "#/$defs/sha256" },
        "image_signer_fingerprint": { "$ref": "#/$defs/sha256" },
        "module_sha256": { "$ref": "#/$defs/sha256" },
        "module_signer_fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_sha256",
        "manifest_signature_sha256",
        "manifest_signer_fingerprint",
        "artifacts"
      ],
      "properties": {
        "provenance_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_signature_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_signer_fingerprint": { "$ref": "#/$defs/sha256" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "architecture", "sha256"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 128 },
              "version": { "type": "string", "minLength": 1, "maxLength": 128 },
              "architecture": { "type": "string", "minLength": 1, "maxLength": 64 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "sanitized_evidence_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
