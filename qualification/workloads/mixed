#!/usr/bin/bash

set -euo pipefail
workload_dir=$(/usr/bin/dirname -- "${BASH_SOURCE[0]}")
source "$workload_dir/common"
require_fixed_workload "$@"

ACTIVE_WORKLOAD_PID=
TRANSITION_GENERATION=0

stop_active_segment() {
  local pid
  if [[ -n ${ACTIVE_WORKLOAD_PID:-} ]]; then
    kill -TERM "$ACTIVE_WORKLOAD_PID" 2>/dev/null || true
    wait "$ACTIVE_WORKLOAD_PID" 2>/dev/null || true
  fi
  # A signal can arrive after Bash registers the background segment but before
  # the following assignment records $!. Contain that unassigned job too.
  while read -r pid; do
    if [[ -n $pid ]]; then
      kill -TERM "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
    fi
  done < <(jobs -pr)
  ACTIVE_WORKLOAD_PID=
}

start_load() {
  stop_active_segment
  "$workload_dir/combined" --fixed &
  ACTIVE_WORKLOAD_PID=$!
}

enter_idle() {
  stop_active_segment
  /usr/bin/sleep infinity &
  ACTIVE_WORKLOAD_PID=$!
}

transition_to_load() {
  start_load
  TRANSITION_GENERATION=$((TRANSITION_GENERATION + 1))
}

transition_to_idle() {
  enter_idle
  TRANSITION_GENERATION=$((TRANSITION_GENERATION + 1))
}

trap transition_to_load USR1
trap transition_to_idle USR2
trap 'stop_active_segment; exit 0' HUP INT TERM

# The endurance harness sends SIGUSR1 for load segments and SIGUSR2 for idle
# segments. The canonical schedule begins under load.
start_load
while true; do
  waited_pid=$ACTIVE_WORKLOAD_PID
  waited_generation=$TRANSITION_GENERATION
  if wait "$waited_pid"; then
    status=1
  else
    status=$?
  fi
  # A transition trap replaces the segment and advances the generation. Any
  # child failure without that explicit marker must remain visible.
  if [[ $TRANSITION_GENERATION -ne $waited_generation ]]; then
    continue
  fi
  stop_active_segment
  exit "$status"
done
