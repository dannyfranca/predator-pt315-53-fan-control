#!/usr/bin/bash

set -euo pipefail
workload_dir=$(dirname -- "${BASH_SOURCE[0]}")
source "$workload_dir/common"
require_fixed_workload "$@"

ACTIVE_WORKLOAD_PID=

stop_active_segment() {
  if [[ -n ${ACTIVE_WORKLOAD_PID:-} ]]; then
    kill -TERM "$ACTIVE_WORKLOAD_PID" 2>/dev/null || true
    wait "$ACTIVE_WORKLOAD_PID" 2>/dev/null || true
    ACTIVE_WORKLOAD_PID=
  fi
}

start_load() {
  stop_active_segment
  "$workload_dir/combined" --fixed &
  ACTIVE_WORKLOAD_PID=$!
}

enter_idle() {
  stop_active_segment
  /usr/bin/sleep infinity &
  ACTIVE_WORKLOAD_PID=$!
}

trap start_load USR1
trap enter_idle USR2
trap 'stop_active_segment; exit 0' HUP INT TERM

# The endurance harness sends SIGUSR1 for load segments and SIGUSR2 for idle
# segments. The canonical schedule begins under load.
start_load
while true; do
  if wait "$ACTIVE_WORKLOAD_PID"; then
    status=1
  else
    status=$?
  fi
  # A handled transition signal interrupts wait after its trap has replaced
  # ACTIVE_WORKLOAD_PID. Continue with that new, tracked segment process.
  if [[ $status -gt 128 ]]; then
    continue
  fi
  stop_active_segment
  exit "$status"
done
