#!/usr/bin/bash

set -euo pipefail

require_fixed_workload() {
  if [[ $# -ne 1 || $1 != --fixed ]]; then
    printf 'usage: %s --fixed\n' "${0##*/}" >&2
    exit 64
  fi
}

start_cpu_workload() {
  /usr/bin/stress-ng \
    --cpu 0 \
    --cpu-method matrixprod \
    --verify \
    --quiet &
  CPU_WORKLOAD_PID=$!
}

start_gpu_workload() {
  /usr/bin/glmark2 \
    --off-screen \
    --run-forever \
    --benchmark 'shading:duration=5.0:shading=phong' &
  GPU_WORKLOAD_PID=$!
}

stop_fixed_workload() {
  local pid
  for pid in "${CPU_WORKLOAD_PID:-}" "${GPU_WORKLOAD_PID:-}"; do
    if [[ -n $pid ]]; then
      kill -TERM "$pid" 2>/dev/null || true
    fi
  done
  for pid in "${CPU_WORKLOAD_PID:-}" "${GPU_WORKLOAD_PID:-}"; do
    if [[ -n $pid ]]; then
      wait "$pid" 2>/dev/null || true
    fi
  done
  # Also cover the tiny interval after Bash has registered a background job
  # but before its PID has been assigned to the corresponding variable.
  while read -r pid; do
    if [[ -n $pid ]]; then
      kill -TERM "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
    fi
  done < <(jobs -pr)
  CPU_WORKLOAD_PID=
  GPU_WORKLOAD_PID=
}

wait_for_fixed_workload() {
  local status
  local -a pids=()
  local pid
  for pid in "${CPU_WORKLOAD_PID:-}" "${GPU_WORKLOAD_PID:-}"; do
    if [[ -n $pid ]]; then
      pids+=("$pid")
    fi
  done
  if [[ ${#pids[@]} -eq 0 ]]; then
    return 1
  fi
  if wait -n "${pids[@]}"; then
    # Every fixed load is intentionally unbounded; a clean child exit is also
    # an incomplete workload and must fail after its sibling is contained.
    status=1
  else
    status=$?
  fi
  stop_fixed_workload
  return "$status"
}

# Installed while this helper is sourced, before any entrypoint can spawn a
# workload child. Individual entrypoints may replace it with a stricter trap.
trap 'stop_fixed_workload; exit 0' HUP INT TERM
