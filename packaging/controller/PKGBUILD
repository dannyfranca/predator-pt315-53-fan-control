# Maintainer: Danny Franca

pkgname=pt31553-fan-control
pkgver=0.1.0
pkgrel=13
pkgdesc='Fail-closed PT315-53 fan controller and qualification suite'
arch=('x86_64')
url='https://github.com/dannyfranca/predator-pt315-53-fan-control'
license=('MIT')
depends=('bash' 'coreutils' 'gcc-libs' 'glibc' 'glmark2' 'kmod' 'nvidia-utils' 'openssl' 'pacman' 'sbsigntools' 'stress-ng' 'systemd')
makedepends=('cargo')
options=('!debug' '!lto')
backup=('etc/pt31553-fan-control/config.toml')
_commit='6df66e2ecb2ecf45cd8b4eb3955762d03f26563c'
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/$_commit.tar.gz"
)
sha256sums=(
  '1616992a0374664455f230e7d1d496b59339b38e2eb744dbc4d366f8754f85ce'
)

prepare() {
  umask 0022
  cd "predator-pt315-53-fan-control-$_commit"
  # GitHub archives preserve group-writable directories throughout the source
  # tree. Keep ownership-sensitive tests and build outputs beneath trusted
  # ancestors, including package-local test fixture directories.
  chmod go-w "$srcdir"
  find . -type d -exec chmod go-w {} +
  cargo fetch --locked --target x86_64-unknown-linux-gnu
}

build() {
  umask 0022
  cd "predator-pt315-53-fan-control-$_commit"
  cargo build --frozen --release --workspace --bins
}

check() {
  umask 0022
  cd "predator-pt315-53-fan-control-$_commit"
  # Neither makepkg's source-handler overrides nor the builder's user/system
  # Git configuration may affect archive tests that create fixture repositories.
  local git_config_variable
  for git_config_variable in "${!GIT_CONFIG@}"; do
    unset "$git_config_variable"
  done
  local cargo_home="${CARGO_HOME:-$HOME/.cargo}"
  local test_home
  test_home=$(mktemp -d "$srcdir/.pt31553-test-home.XXXXXX")
  install -d -m 0700 "$test_home/.config"
  ln -sfnT "$cargo_home" "$test_home/.cargo"
  : >"$test_home/.gitconfig"
  chmod 0600 "$test_home/.gitconfig"
  export HOME="$test_home"
  export XDG_CONFIG_HOME="$test_home/.config"
  export GIT_CONFIG_NOSYSTEM=1
  # build() creates target directories after prepare() hardens the extracted
  # tree. Re-harden every directory before ownership-sensitive tests run, then
  # create their package-local fixture parent with an explicit safe mode.
  find . -type d -exec chmod go-w {} +
  install -d -m 0755 crates/fan-control-core/target
  export RUSTFLAGS="${RUSTFLAGS:-} -C debug-assertions=yes"
  cargo test --frozen --workspace --exclude fan-control-core

  # This GitHub archive has no index or history. Run every core test target
  # except the repository-only source-complete handoff tests, which CI runs
  # against the checkout before building this locked package.
  local core_test_args=()
  local test_path test_name
  for test_path in crates/fan-control-core/tests/*.rs; do
    test_name=${test_path##*/}
    test_name=${test_name%.rs}
    [[ $test_name == source_complete_handoff ]] && continue
    core_test_args+=(--test "$test_name")
  done
  cargo test --frozen -p fan-control-core --lib "${core_test_args[@]}"
  cargo test --frozen -p fan-control-core --doc
}

package() {
  local source_root="$srcdir/predator-pt315-53-fan-control-$_commit"

  install -Dm755 "$source_root/target/release/fan-control-daemon" \
    "$pkgdir/usr/bin/pt31553-fand"
  install -Dm755 "$source_root/target/release/fan-control-restore" \
    "$pkgdir/usr/bin/pt31553-fan-restore"
  install -Dm755 "$source_root/target/release/fan-control-qualify" \
    "$pkgdir/usr/bin/pt31553-fan-qualify"
  install -Dm755 "$source_root/target/release/fan-control-observer" \
    "$pkgdir/usr/bin/pt31553-fan-observer"

  install -Dm644 "$source_root/systemd/pt31553-fand.service" \
    "$pkgdir/usr/lib/systemd/system/pt31553-fand.service"
  install -Dm644 "$source_root/systemd/pt31553-fan-sleep-guard.service" \
    "$pkgdir/usr/lib/systemd/system/pt31553-fan-sleep-guard.service"
  install -Dm644 "$source_root/systemd/90-pt31553-fan-control.preset" \
    "$pkgdir/usr/lib/systemd/system-preset/90-pt31553-fan-control.preset"
  install -Dm644 "$source_root/packaging/controller/pt31553-fan-control.tmpfiles" \
    "$pkgdir/usr/lib/tmpfiles.d/pt31553-fan-control.conf"

  install -Dm640 "$source_root/config/example.toml" \
    "$pkgdir/etc/pt31553-fan-control/config.toml"
  install -Dm644 "$source_root/compatibility/pt315-53.toml" \
    "$pkgdir/usr/lib/pt31553-fan-control/compatibility.toml"
  install -Dm644 "$source_root/schemas/evidence.json" \
    "$pkgdir/usr/share/pt31553-fan-control/schemas/evidence.json"
  install -Dm644 "$source_root/schemas/evidence-v2.json" \
    "$pkgdir/usr/share/pt31553-fan-control/schemas/evidence-v2.json"
  install -Dm644 "$source_root/schemas/candidate-identity-v1.json" \
    "$pkgdir/usr/share/pt31553-fan-control/schemas/candidate-identity-v1.json"
  install -Dm644 "$source_root/schemas/package-provenance-v1.json" \
    "$pkgdir/usr/share/pt31553-fan-control/schemas/package-provenance-v1.json"
  install -Dm644 "$source_root/schemas/promotion-manifest.json" \
    "$pkgdir/usr/share/pt31553-fan-control/schemas/promotion-manifest.json"
  install -Dm644 "$source_root/schemas/qualification-record.json" \
    "$pkgdir/usr/share/pt31553-fan-control/schemas/qualification-record.json"
  install -Dm644 "$source_root/policy/qualified-envelope.example.toml" \
    "$pkgdir/usr/share/pt31553-fan-control/examples/qualified-envelope.example.toml"
  install -dm755 "$pkgdir/usr/share/pt31553-fan-control"
  printf '%s\n' "$_commit" \
    >"$pkgdir/usr/share/pt31553-fan-control/source-commit"
  chmod 0644 "$pkgdir/usr/share/pt31553-fan-control/source-commit"

  install -dm755 "$pkgdir/usr/lib/pt31553-fan-control/workloads"
  install -m644 \
    "$source_root/qualification/workloads/common" \
    "$source_root/qualification/workloads/VERSION" \
    "$pkgdir/usr/lib/pt31553-fan-control/workloads/"
  install -m755 \
    "$source_root/qualification/workloads/idle" \
    "$source_root/qualification/workloads/cpu" \
    "$source_root/qualification/workloads/gpu" \
    "$source_root/qualification/workloads/combined" \
    "$source_root/qualification/workloads/mixed" \
    "$pkgdir/usr/lib/pt31553-fan-control/workloads/"

  install -dm700 \
    "$pkgdir/var/lib/pt31553-fan-control" \
    "$pkgdir/var/lib/pt31553-fan-control/evidence"
  install -Dm644 "$source_root/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
