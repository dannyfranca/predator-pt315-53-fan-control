#!/usr/bin/env bash
set -euo pipefail

PATH=/usr/bin
export PATH
trusted_path_mode=$(/usr/bin/stat -c %a /usr/bin)
[[ $(/usr/bin/stat -c %u /usr/bin) == 0 && \
    $((8#$trusted_path_mode & 8#022)) == 0 ]] || {
    echo "unsafe fixed host command path" >&2
    exit 2
}

: "${SOURCE_LOCK_BUNDLE:?set SOURCE_LOCK_BUNDLE to the verified bundle directory}"
if (( $# > 1 )); then
    echo "only the locked build, --compile-pwm, or --verifysource is allowed" >&2
    exit 2
elif (( $# == 1 )) && [[ "$1" != --compile-pwm && "$1" != --verifysource ]]; then
    echo "only the locked build, --compile-pwm, or --verifysource is allowed" >&2
    exit 2
fi

toolchain_origin="docker.io/cachyos/docker-makepkg-v4@sha256:1c9d839ed8baec04826f0a16435d27de470eaa50bc3068f0ef0f4d44508706c6"
toolchain="docker.io/library/source-lock@sha256:1c9d839ed8baec04826f0a16435d27de470eaa50bc3068f0ef0f4d44508706c6"
packaging="linux-cachyos-3c399d306eed6497838b246b9dbe73ec2cd1bb2f.tar.gz"
telemetry_patch="0001-acer-wmi-add-pt31553-telemetry.patch"
pwm_patch="0002-acer-wmi-enable-pt31553-pwm.patch"
bc_package="bc-1.08.2-1.1-x86_64_v4.pkg.tar.zst"
nvidia_source="NVIDIA-kernel-module-source-610.57.04.tar.xz"
nvidia_patch_dsc="0002-fix-dsc-correct-RC-parameter-tables-to-match-VESA-DS.patch"
nvidia_patch_vr="0004-fix-dp-add-Bigscreen-Beyond-VR-headset-to-WAR-databa.patch"

if [[ "${SOURCE_LOCK_INSIDE:-}" == 1 ]]; then
    : "${SOURCE_LOCK_OUTPUT:?container output mount is required}"
    unset CI GITHUB_RUN_ID
    export SOURCE_DATE_EPOCH=1786378335
    export SRCDEST=/work/source-cache
    export PKGDEST=$SOURCE_LOCK_OUTPUT
    export _cachy_config=yes
    export _cpusched=cachyos
    export _makenconfig=no
    export _makexconfig=no
    export _localmodcfg=no
    export _use_current=no
    export _cc_harder=yes
    export _per_gov=no
    export _tcp_bbr3=no
    export _HZ_ticks=1000
    export _tickrate=full
    export _preempt=full
    export _hugepage=always
    export _processor_opt=generic_v4
    export _use_llvm_lto=none
    export _use_lto_suffix=no
    export _use_gcc_suffix=yes
    export _use_kcfi=no
    export _build_zfs=no
    export _build_nvidia_open=yes
    export _build_r8125=no
    export _build_debug=no
    export _autofdo=no
    export _propeller=no

    if [[ "${1:-}" == --compile-pwm ]]; then
        rm -f -- "$SOURCE_LOCK_OUTPUT/acer-wmi.o" \
            "$SOURCE_LOCK_OUTPUT/acer-wmi.o.sha256"
        compile_root="$PWD/pwm-compile"
        tools_root="$compile_root/tools"
        source_root="$compile_root/source"
        mkdir -p "$tools_root/bin" "$source_root"
        tar --extract --file "$SOURCE_LOCK_BUNDLE/build-tools/$bc_package" \
            --to-stdout usr/bin/bc >"$tools_root/bin/bc"
        chmod 0555 "$tools_root/bin/bc"
        tar --extract --gzip --file "$SOURCE_LOCK_BUNDLE/cachyos-7.1.8-1.tar.gz" \
            --directory "$source_root" --strip-components=1
        patch --directory "$source_root" -Np1 \
            <"$SOURCE_LOCK_BUNDLE/patches/$telemetry_patch"
        patch --directory "$source_root" -Np1 \
            <"$SOURCE_LOCK_BUNDLE/patches/$pwm_patch"
        cp "$SOURCE_LOCK_BUNDLE/config" "$source_root/.config"
        PATH="$tools_root/bin:$PATH" make -C "$source_root" olddefconfig
        PATH="$tools_root/bin:$PATH" make -C "$source_root" -j2 \
            drivers/platform/x86/acer-wmi.o
        install -m 0444 "$source_root/drivers/platform/x86/acer-wmi.o" \
            "$SOURCE_LOCK_OUTPUT/acer-wmi.o"
        (
            cd "$SOURCE_LOCK_OUTPUT"
            sha256sum acer-wmi.o >acer-wmi.o.sha256
        )
        exit 0
    fi

    if [[ "${1:-}" == --verifysource ]]; then
        exec makepkg --config "$SOURCE_LOCK_BUNDLE/makepkg.conf" --skippgpcheck \
            --skipchecksums --noconfirm --verifysource
    fi

    if find "$SOURCE_LOCK_OUTPUT" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
        echo "package output directory must be empty before a locked build" >&2
        exit 2
    fi

    expected_packages=(
        linux-cachyos-pt31553
        linux-cachyos-pt31553-headers
        linux-cachyos-pt31553-nvidia-open
    )
    # shellcheck disable=SC1091 -- the authenticated recipe is the build input.
    source ./PKGBUILD
    [[ "$pkgbase" == linux-cachyos-pt31553 ]]
    [[ "$_kernuname" == 7.1.8-cachyos-pt31553 ]]
    [[ "${pkgname[*]}" == "${expected_packages[*]}" ]]
    : "${SOURCE_LOCK_INSIDE_SIGNING_DIR:=/signing}"
    [[ -f "$SOURCE_LOCK_INSIDE_SIGNING_DIR/module-signing-key.pem" && ! -L "$SOURCE_LOCK_INSIDE_SIGNING_DIR/module-signing-key.pem" ]]
    [[ -f "$SOURCE_LOCK_INSIDE_SIGNING_DIR/module-signing-certificate.der" && ! -L "$SOURCE_LOCK_INSIDE_SIGNING_DIR/module-signing-certificate.der" ]]

    install -m 0444 "$SOURCE_LOCK_BUNDLE/source-lock.toml" \
        "$SOURCE_LOCK_OUTPUT/source-lock.toml"
    install -m 0444 "$SOURCE_LOCK_BUNDLE/build-environment.toml" \
        "$SOURCE_LOCK_OUTPUT/build-environment.toml"
    install -m 0444 ./PKGBUILD "$SOURCE_LOCK_OUTPUT/PKGBUILD"
    makepkg --config "$SOURCE_LOCK_BUNDLE/makepkg.conf" --printsrcinfo \
        >"$SOURCE_LOCK_OUTPUT/package-set.SRCINFO"
    {
        printf 'format = 1\n'
        printf 'source_lock_sha256 = "%s"\n' \
            "$(sha256sum "$SOURCE_LOCK_OUTPUT/source-lock.toml" | cut -d ' ' -f 1)"
        printf 'build_environment_sha256 = "%s"\n' \
            "$(sha256sum "$SOURCE_LOCK_OUTPUT/build-environment.toml" | cut -d ' ' -f 1)"
        printf 'pkgbuild_sha256 = "%s"\n' \
            "$(sha256sum "$SOURCE_LOCK_OUTPUT/PKGBUILD" | cut -d ' ' -f 1)"
        printf 'package_set_srcinfo_sha256 = "%s"\n' \
            "$(sha256sum "$SOURCE_LOCK_OUTPUT/package-set.SRCINFO" | cut -d ' ' -f 1)"
    } >"$SOURCE_LOCK_OUTPUT/build-attestation.toml"
    chmod 0444 "$SOURCE_LOCK_OUTPUT/build-attestation.toml"

    package_list=$(mktemp "$SOURCE_LOCK_OUTPUT/.packagelist.XXXXXX")
    if ! makepkg --config "$SOURCE_LOCK_BUNDLE/makepkg.conf" --packagelist \
        >"$package_list"; then
        rm -f -- "$package_list"
        exit 1
    fi
    mapfile -t package_paths <"$package_list"
    rm -f -- "$package_list"
    [[ "${#package_paths[@]}" -eq "${#expected_packages[@]}" ]]
    makepkg --config "$SOURCE_LOCK_BUNDLE/makepkg.conf" --skippgpcheck \
        --skipchecksums --noconfirm --cleanbuild 2>&1 \
        | tee "$SOURCE_LOCK_OUTPUT/build.log"

    mapfile -d '' -t produced_package_paths < <(
        find "$SOURCE_LOCK_OUTPUT" -mindepth 1 -maxdepth 1 -type f \
            -name '*.pkg.tar.zst' -print0 | sort -z
    )
    [[ "${#produced_package_paths[@]}" -eq "${#expected_packages[@]}" ]]
    declare -A produced_packages=()
    for produced in "${produced_package_paths[@]}"; do
        produced=$(realpath "$produced")
        [[ "$produced" == "$SOURCE_LOCK_OUTPUT/"* && -f "$produced" ]]
        produced_packages["$produced"]=1
    done
    [[ "${#produced_packages[@]}" -eq "${#expected_packages[@]}" ]]
    for package in "${package_paths[@]}"; do
        package=$(realpath "$package")
        [[ ${produced_packages["$package"]+present} ]]
    done

    evidence_root=$(mktemp -d "$SOURCE_LOCK_OUTPUT/.evidence.XXXXXX")
    cleanup_evidence() {
        [[ -z "${evidence_root:-}" ]] || rm -rf -- "$evidence_root"
    }
    trap cleanup_evidence EXIT
    mkdir "$evidence_root/packages"
    for index in "${!expected_packages[@]}"; do
        package="${package_paths[$index]}"
        package_name="${expected_packages[$index]}"
        package=$(realpath "$package")
        [[ "$package" == "$SOURCE_LOCK_OUTPUT/"* && -f "$package" ]]
        metadata="$evidence_root/packages/$package_name"
        mkdir "$metadata"
        for entry in .BUILDINFO .MTREE .PKGINFO; do
            bsdtar -xOf "$package" "$entry" >"$metadata/$entry"
        done
        grep -Fxq "pkgname = $package_name" "$metadata/.PKGINFO"
    done
    chmod 0444 "$evidence_root"/packages/*/.*INFO \
        "$evidence_root"/packages/*/.MTREE
    mv "$evidence_root/packages" "$SOURCE_LOCK_OUTPUT/packages"
    rmdir "$evidence_root"
    evidence_root=
    trap - EXIT
    chmod 0444 "$SOURCE_LOCK_OUTPUT/build.log" \
        "$SOURCE_LOCK_OUTPUT/package-set.SRCINFO"
    manifest=$(mktemp "$SOURCE_LOCK_OUTPUT/.SHA256SUMS.XXXXXX")
    (
        cd "$SOURCE_LOCK_OUTPUT"
        for retained in \
            PKGBUILD build-attestation.toml build-environment.toml build.log \
            package-set.SRCINFO source-lock.toml; do
            sha256sum -- "$retained"
        done
        for package_name in "${expected_packages[@]}"; do
            for entry in .BUILDINFO .MTREE .PKGINFO; do
                sha256sum -- "packages/$package_name/$entry"
            done
        done
        for package in "${package_paths[@]}"; do
            sha256sum "$package" | sed 's#  .*/#  #'
        done
    ) | LC_ALL=C sort >"$manifest"
    chmod 0444 "$manifest"
    mv "$manifest" "$SOURCE_LOCK_OUTPUT/SHA256SUMS"
    exit 0
fi

: "${SOURCE_LOCK_OUTPUT:?set SOURCE_LOCK_OUTPUT to an existing output directory}"
[[ -d "$SOURCE_LOCK_BUNDLE" && ! -L "$SOURCE_LOCK_BUNDLE" ]] || {
    echo "SOURCE_LOCK_BUNDLE must be a non-symlink directory" >&2
    exit 2
}
[[ -d "$SOURCE_LOCK_OUTPUT" && ! -L "$SOURCE_LOCK_OUTPUT" ]] || {
    echo "SOURCE_LOCK_OUTPUT must be a non-symlink directory" >&2
    exit 2
}
command -v podman >/dev/null || {
    echo "podman is required to run the pinned toolchain" >&2
    exit 2
}

bundle=$(realpath "$SOURCE_LOCK_BUNDLE")
output=$(realpath "$SOURCE_LOCK_OUTPUT")
output_parent=${output%/*}
output_mode=$(stat -c %a "$output")
output_parent_mode=$(stat -c %a "$output_parent")
[[ $(/usr/bin/stat -c %u "$output") == $EUID && \
    $(/usr/bin/stat -c %u "$output_parent") == $EUID && \
    $((8#$output_mode & 8#022)) == 0 && \
    $((8#$output_parent_mode & 8#022)) == 0 ]] || {
    echo "output and its parent must be caller-owned and not group/other writable" >&2
    exit 2
}
if find "$output" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
    echo "package output directory must be empty before a locked build" >&2
    exit 2
fi
work_root=$(mktemp -d "${TMPDIR:-/tmp}/source-lock-build.XXXXXX")
package_root="$work_root/package"
image_layout="$work_root/image"
container_output=
cleanup() {
    if [[ -n "$container_output" && "$container_output" != "$output" ]]; then
        podman unshare rm -rf -- "$container_output" 2>/dev/null || true
    fi
    podman unshare chmod -R u+rwX "$work_root" 2>/dev/null || true
    podman unshare rm -rf -- "$work_root"
}
trap cleanup EXIT

mkdir -p "$package_root" "$image_layout/blobs/sha256" \
    "$work_root/podman-root" "$work_root/podman-runroot"
podman_storage=(
    --root "$work_root/podman-root"
    --runroot "$work_root/podman-runroot"
    --storage-driver=overlay
)
tar --extract --gzip --file "$bundle/$packaging" --directory "$package_root" \
    --strip-components=2 "linux-cachyos-3c399d306eed6497838b246b9dbe73ec2cd1bb2f/linux-cachyos"
[[ -f "$package_root/PKGBUILD" ]] || {
    echo "pinned packaging snapshot did not yield PKGBUILD" >&2
    exit 1
}
mkdir "$package_root/source-cache"
ln -s /bundle/cachyos-7.1.8-1.tar.gz "$package_root/source-cache/cachyos-7.1.8-1.tar.gz"
ln -s /bundle/cachyos-7.1.8-1.tar.gz.asc "$package_root/source-cache/cachyos-7.1.8-1.tar.gz.asc"
ln -s /bundle/config "$package_root/source-cache/config"
ln -s "/bundle/patches/$telemetry_patch" "$package_root/source-cache/$telemetry_patch"
ln -s "/bundle/patches/$pwm_patch" "$package_root/source-cache/$pwm_patch"
ln -s "/bundle/$nvidia_source" "$package_root/source-cache/$nvidia_source"
ln -s "/bundle/nvidia/$nvidia_patch_dsc" "$package_root/source-cache/$nvidia_patch_dsc"
ln -s "/bundle/nvidia/$nvidia_patch_vr" "$package_root/source-cache/$nvidia_patch_vr"
printf '\nsource+=("%s" "%s")\nb2sums+=("SKIP" "SKIP")\n' \
    "$telemetry_patch" "$pwm_patch" >>"$package_root/PKGBUILD"
[[ "$(grep -Fxc 'pkgbase="linux-$_pkgsuffix"' "$package_root/PKGBUILD")" == 1 ]]
sed -i 's/^pkgbase="linux-$_pkgsuffix"$/pkgbase="linux-cachyos-pt31553"/' \
    "$package_root/PKGBUILD"
[[ "$(grep -Fxc '_kernuname="${pkgver}-${_pkgsuffix}"' "$package_root/PKGBUILD")" == 1 ]]
sed -i 's/^_kernuname="${pkgver}-${_pkgsuffix}"$/_kernuname="${pkgver}-cachyos-pt31553"/' \
    "$package_root/PKGBUILD"
[[ "$(grep -Fc 'CachyOS/kernel-patches/master/' "$package_root/PKGBUILD")" -ge 1 ]]
sed -i 's#CachyOS/kernel-patches/master/#CachyOS/kernel-patches/fcdc4806b62f86b62a61b92c4b7213a1759537e5/#g' \
    "$package_root/PKGBUILD"
! grep -Fq 'CachyOS/kernel-patches/master/' "$package_root/PKGBUILD"
printf 'b2sums+=("SKIP" "SKIP")\n' >>"$package_root/PKGBUILD"
signing_recipe=(
    'eval "$(declare -f prepare | sed "1s/^prepare /_source_lock_prepare /")"'
    'prepare() {'
    '    _source_lock_prepare'
    '    install -Dm0400 "$SOURCE_LOCK_INSIDE_SIGNING_DIR/module-signing-key.pem" "certs/signing_key.pem"'
    '    install -Dm0444 "$SOURCE_LOCK_INSIDE_SIGNING_DIR/module-signing-certificate.der" "certs/signing_key.x509"'
    '}'
    'eval "$(declare -f "package_$pkgbase-headers" | sed "1s/^package_${pkgbase}-headers /_source_lock_package_headers /")"'
    'eval "package_$pkgbase-headers() { _source_lock_package_headers; install -Dm0444 \"\$SOURCE_LOCK_INSIDE_SIGNING_DIR/module-signing-certificate.der\" \"\$pkgdir/usr/lib/modules/\$(<version)/build/certs/signing_key.x509\"; }"'
)
printf '%s\n' "${signing_recipe[@]}" >>"$package_root/PKGBUILD"

if (( $# == 0 )); then
    : "${SOURCE_LOCK_SIGNING_DIR:?set SOURCE_LOCK_SIGNING_DIR to the external signing directory}"
    trusted_tools=(
        "/usr/bin/bsdtar" "/usr/bin/openssl" "/usr/bin/python3"
        "/usr/bin/sbsign" "/usr/bin/sbverify" "/usr/bin/zstd"
    )
    for trusted_tool in "${trusted_tools[@]}"; do
        trusted_resolved=$(/usr/bin/realpath --canonicalize-existing "$trusted_tool")
        [[ "$trusted_resolved" == /usr/bin/* && -f "$trusted_resolved" && \
            -x "$trusted_resolved" && $(/usr/bin/stat -c %u "$trusted_resolved") == 0 ]]
        trusted_mode=$(/usr/bin/stat -c %a "$trusted_resolved")
        (( (8#$trusted_mode & 8#022) == 0 )) || {
            echo "unsafe host tool: $trusted_tool" >&2
            exit 2
        }
    done
    signing_lexical=$(/usr/bin/realpath --canonicalize-existing --no-symlinks \
        "$SOURCE_LOCK_SIGNING_DIR")
    signing_source=$(/usr/bin/realpath --canonicalize-existing "$SOURCE_LOCK_SIGNING_DIR")
    [[ -d "$signing_source" && "$signing_source" == "$signing_lexical" ]] || {
        echo "SOURCE_LOCK_SIGNING_DIR must be a non-symlink directory" >&2
        exit 2
    }
    signing="$work_root/signing-snapshot"
    mkdir -m 0700 "$signing"
    /usr/bin/python3 -I - "$signing_source" "$signing" <<'PY'
import os
import pathlib
import stat
import sys

source = pathlib.Path(sys.argv[1])
destination = pathlib.Path(sys.argv[2])
expected = {
    "kernel-signing-certificate.pem": (0o444, False),
    "kernel-signing-key.pem": (0o400, True),
    "module-signing-certificate.der": (0o444, False),
    "module-signing-key.pem": (0o400, True),
}
source_fd = os.open(source, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    directory = os.fstat(source_fd)
    if directory.st_uid != os.geteuid() or directory.st_mode & 0o077:
        raise SystemExit("signing directory must be owned by the caller and mode 0700")
    if set(os.listdir(source_fd)) != set(expected):
        raise SystemExit("signing directory must contain exactly the four documented inputs")
    for name, (destination_mode, private) in expected.items():
        source_file = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=source_fd)
        try:
            before = os.fstat(source_file)
            if (
                not stat.S_ISREG(before.st_mode)
                or before.st_nlink != 1
                or before.st_uid != os.geteuid()
                or not before.st_mode & 0o400
                or (before.st_mode & (0o077 if private else 0o022))
                or before.st_size > 1024 * 1024
            ):
                raise SystemExit(f"unsafe signing input: {name}")
            chunks = []
            remaining = 1024 * 1024 + 1
            while remaining:
                chunk = os.read(source_file, min(65536, remaining))
                if not chunk:
                    break
                chunks.append(chunk)
                remaining -= len(chunk)
            after = os.fstat(source_file)
            stable = (
                before.st_dev,
                before.st_ino,
                before.st_size,
                before.st_mtime_ns,
                before.st_ctime_ns,
            ) == (
                after.st_dev,
                after.st_ino,
                after.st_size,
                after.st_mtime_ns,
                after.st_ctime_ns,
            )
            content = b"".join(chunks)
            if not stable or len(content) != before.st_size or not content:
                raise SystemExit(f"signing input changed while snapshotting: {name}")
        finally:
            os.close(source_file)
        output = os.open(
            destination / name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            destination_mode,
        )
        try:
            os.fchmod(output, destination_mode)
            view = memoryview(content)
            while view:
                written = os.write(output, view)
                view = view[written:]
            os.fsync(output)
        finally:
            os.close(output)
    destination_fd = os.open(destination, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(destination_fd)
    finally:
        os.close(destination_fd)
finally:
    os.close(source_fd)
PY
    /usr/bin/openssl x509 -inform DER -in "$signing/module-signing-certificate.der" \
        -noout >/dev/null
    /usr/bin/openssl x509 -in "$signing/kernel-signing-certificate.pem" -noout >/dev/null
    module_key_public=$(/usr/bin/openssl pkey -in "$signing/module-signing-key.pem" \
        -pubout -outform DER | /usr/bin/sha256sum | /usr/bin/cut -d ' ' -f 1)
    module_cert_public=$(/usr/bin/openssl x509 -inform DER \
        -in "$signing/module-signing-certificate.der" -pubkey -noout | \
        /usr/bin/openssl pkey -pubin -outform DER | /usr/bin/sha256sum | \
        /usr/bin/cut -d ' ' -f 1)
    [[ "$module_key_public" == "$module_cert_public" ]] || {
        echo "module signing key does not match its certificate" >&2
        exit 2
    }
    kernel_key_public=$(/usr/bin/openssl pkey -in "$signing/kernel-signing-key.pem" \
        -pubout -outform DER | /usr/bin/sha256sum | /usr/bin/cut -d ' ' -f 1)
    kernel_cert_public=$(/usr/bin/openssl x509 \
        -in "$signing/kernel-signing-certificate.pem" -pubkey -noout | \
        /usr/bin/openssl pkey -pubin -outform DER | /usr/bin/sha256sum | \
        /usr/bin/cut -d ' ' -f 1)
    [[ "$kernel_key_public" == "$kernel_cert_public" ]] || {
        echo "kernel signing key does not match its certificate" >&2
        exit 2
    }
    module_signing="$work_root/module-signing"
    mkdir -m 0700 "$module_signing"
    install -m 0400 "$signing/module-signing-key.pem" \
        "$module_signing/module-signing-key.pem"
    install -m 0444 "$signing/module-signing-certificate.der" \
        "$module_signing/module-signing-certificate.der"
    signing_mount=(--mount "type=bind,src=$module_signing,dst=/signing,ro=true")
else
    signing_mount=()
fi

container_output="$output"
if (( $# == 0 )); then
    container_output=$(mktemp -d "$output_parent/.source-lock-output.XXXXXX")
    chmod 0700 "$container_output"
fi

printf '{"imageLayoutVersion":"1.0.0"}\n' >"$image_layout/oci-layout"
printf '{"schemaVersion":2,"manifests":[{"mediaType":"application/vnd.docker.distribution.manifest.v2+json","digest":"sha256:1c9d839ed8baec04826f0a16435d27de470eaa50bc3068f0ef0f4d44508706c6","size":3656,"annotations":{"org.opencontainers.image.ref.name":"source-lock"}}]}\n' >"$image_layout/index.json"
ln -s "$bundle/toolchain-image-manifest.json" \
    "$image_layout/blobs/sha256/1c9d839ed8baec04826f0a16435d27de470eaa50bc3068f0ef0f4d44508706c6"
for blob in "$bundle"/oci/blobs/sha256/*; do
    ln -s "$blob" "$image_layout/blobs/sha256/${blob##*/}"
done
podman "${podman_storage[@]}" pull --quiet "oci:$image_layout:source-lock" >/dev/null

podman "${podman_storage[@]}" run --rm --pull=never --network=none --read-only \
    --userns=keep-id:uid=1000,gid=1000 \
    --tmpfs /tmp:rw,nodev,nosuid \
    --mount "type=bind,src=$bundle,dst=/bundle,ro=true" \
    --mount "type=bind,src=$package_root,dst=/work,rw=true" \
    --mount "type=bind,src=$container_output,dst=/output,rw=true" \
    "${signing_mount[@]}" \
    --workdir /work \
    --env SOURCE_LOCK_INSIDE=1 \
    --env SOURCE_LOCK_INSIDE_SIGNING_DIR=/signing \
    --env SOURCE_LOCK_BUNDLE=/bundle \
    --env SOURCE_LOCK_OUTPUT=/output \
    --entrypoint /bundle/build-candidate \
    "$toolchain" "$@"

if (( $# == 0 )); then
    kernel_archive="$container_output/linux-cachyos-pt31553-7.1.8-1-x86_64.pkg.tar.zst"
    [[ -f "$kernel_archive" && ! -L "$kernel_archive" ]]
    /usr/bin/python3 -I "$bundle/check-sensitive-history" --tree "$container_output" \
        --allow-public-certificate "$signing/module-signing-certificate.der" \
        --allow-public-certificate "$signing/kernel-signing-certificate.pem"
    final_root="$work_root/kernel-finalize"
    mkdir "$final_root"
    /usr/bin/bsdtar --no-same-owner --no-same-permissions --no-xattrs --no-fflags \
        -xf "$kernel_archive" -C "$final_root"
