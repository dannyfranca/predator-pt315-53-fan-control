#!/usr/bin/python3 -I
"""Generate non-authoritative PT315-53 candidate identity declarations."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import re
import secrets
import selectors
import stat
import subprocess
import sys
import tempfile
import time
import tomllib


HEX40 = re.compile(r"[0-9a-f]{40}\Z")
OPENPGP_FINGERPRINT = re.compile(r"[0-9A-F]{40}\Z")
HEX64 = re.compile(r"[0-9a-f]{64}\Z")
SAFE_IDENTITY = re.compile(r"[A-Za-z0-9][A-Za-z0-9._+:-]*\Z")
PLACEHOLDERS = {"0" * 64, "f" * 64}
TOOLS = {
    "bsdtar": pathlib.Path("/usr/bin/bsdtar"),
    "gpg": pathlib.Path("/usr/bin/gpg"),
    "pacman-key": pathlib.Path("/usr/bin/pacman-key"),
}
EXPECTED_CANDIDATE = "linux-cachyos-pt31553-7.1.8-1-package-set"
EXPECTED_PACKAGES = [
    "linux-cachyos-pt31553",
    "linux-cachyos-pt31553-headers",
    "linux-cachyos-pt31553-nvidia-open",
]
EXPECTED_MODULES = [
    (
        "acer_wmi",
        "/usr/lib/modules/7.1.8-cachyos-pt31553/kernel/drivers/platform/x86/acer-wmi.ko.zst",
        "in-tree",
        "linux-cachyos-pt31553",
        {"kind": "kernel-tree", "revision": "7a84732fd5e4350c1312fd0ed0c72ffa139fb766"},
    ),
    (
        "nvidia",
        "/usr/lib/modules/7.1.8-cachyos-pt31553/extramodules/nvidia.ko.zst",
        "nvidia-open",
        "linux-cachyos-pt31553-nvidia-open",
        {"kind": "nvidia-open", "revision": "610.57.04"},
    ),
    (
        "nvidia_drm",
        "/usr/lib/modules/7.1.8-cachyos-pt31553/extramodules/nvidia-drm.ko.zst",
        "nvidia-open",
        "linux-cachyos-pt31553-nvidia-open",
        {"kind": "nvidia-open", "revision": "610.57.04"},
    ),
    (
        "nvidia_modeset",
        "/usr/lib/modules/7.1.8-cachyos-pt31553/extramodules/nvidia-modeset.ko.zst",
        "nvidia-open",
        "linux-cachyos-pt31553-nvidia-open",
        {"kind": "nvidia-open", "revision": "610.57.04"},
    ),
    (
        "nvidia_peermem",
        "/usr/lib/modules/7.1.8-cachyos-pt31553/extramodules/nvidia-peermem.ko.zst",
        "nvidia-open",
        "linux-cachyos-pt31553-nvidia-open",
        {"kind": "nvidia-open", "revision": "610.57.04"},
    ),
    (
        "nvidia_uvm",
        "/usr/lib/modules/7.1.8-cachyos-pt31553/extramodules/nvidia-uvm.ko.zst",
        "nvidia-open",
        "linux-cachyos-pt31553-nvidia-open",
        {"kind": "nvidia-open", "revision": "610.57.04"},
    ),
]


class DeclarationError(Exception):
    pass


def fail(message: str) -> None:
    raise DeclarationError(message)


def regular_bytes(path: pathlib.Path, label: str, limit: int = 512 * 1024 * 1024) -> bytes:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        fail(f"missing or unsafe {label}")
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1 or metadata.st_size > limit:
            fail(f"{label} must be one bounded regular file")
        content = bytearray()
        while chunk := os.read(descriptor, min(1024 * 1024, limit + 1 - len(content))):
            content.extend(chunk)
            if len(content) > limit:
                fail(f"{label} is too large")
        return bytes(content)
    finally:
        os.close(descriptor)


def sha256(path: pathlib.Path, label: str) -> str:
    digest = hashlib.sha256()
    content = regular_bytes(path, label)
    digest.update(content)
    return digest.hexdigest()


def snapshot(path: pathlib.Path, label: str, directory: pathlib.Path, limit: int) -> tuple[pathlib.Path, bytes]:
    content = regular_bytes(path, label, limit)
    destination = directory / label.replace(" ", "-")
    try:
        descriptor = os.open(
            destination,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o400,
        )
        view = memoryview(content)
        while view:
            view = view[os.write(descriptor, view):]
        os.fsync(descriptor)
    except OSError:
        fail(f"could not snapshot {label}")
    finally:
        if "descriptor" in locals():
            os.close(descriptor)
    return destination, content


def exact_keys(value: object, expected: set[str], label: str) -> dict:
    if not isinstance(value, dict) or set(value) != expected:
        fail(f"{label} fields do not match schema")
    return value


def hash_value(value: object, label: str, *, allow_placeholder: bool = False) -> str:
    if not isinstance(value, str) or not HEX64.fullmatch(value):
        fail(f"invalid {label}")
    if not allow_placeholder and value in PLACEHOLDERS:
        fail(f"placeholder {label} is forbidden")
    return value


def openpgp_fingerprint(value: object, label: str) -> str:
    if (
        not isinstance(value, str)
        or not OPENPGP_FINGERPRINT.fullmatch(value)
        or value in {"0" * 40, "F" * 40}
    ):
        fail(f"invalid {label}")
    return value


def trusted_tool(name: str) -> pathlib.Path:
    try:
        path = TOOLS[name].resolve(strict=True)
        metadata = path.stat()
    except (KeyError, OSError):
        fail(f"missing trusted tool: {name}")
    if (
        path.parent != pathlib.Path("/usr/bin")
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != 0
        or metadata.st_mode & 0o022
        or not metadata.st_mode & 0o111
    ):
        fail(f"unsafe trusted tool: {name}")
    return path


def run_tool(name: str, *arguments: str) -> bytes:
    result = subprocess.run(
        [trusted_tool(name), *arguments],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        fail(f"{name} rejected the controller package")
    return result.stdout


def package_member(package: pathlib.Path, member: str, label: str) -> bytes:
    process = subprocess.Popen(
        [trusted_tool("bsdtar"), "-xOf", str(package), member],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    assert process.stdout is not None
    content = bytearray()
    deadline = time.monotonic() + 30
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ)
    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not selector.select(remaining):
                process.kill()
                process.wait()
                fail(f"timed out reading packaged {label}")
            chunk = os.read(process.stdout.fileno(), 64 * 1024)
            if not chunk:
                break
            content.extend(chunk)
            if len(content) > 1024 * 1024:
                process.kill()
                process.wait()
                fail(f"packaged {label} is too large")
        if process.wait(timeout=max(0.1, deadline - time.monotonic())) != 0 or not content:
            fail(f"invalid packaged {label}")
        return bytes(content)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()
        fail(f"timed out reading packaged {label}")
    finally:
        selector.close()
        process.stdout.close()


def controller_metadata(
    package: pathlib.Path,
    signature: pathlib.Path,
    compatibility: bytes,
    expected_signer: str,
) -> tuple[str, str, str, str]:
    regular_bytes(package, "controller package")
    regular_bytes(signature, "controller package signature", 16 * 1024 * 1024)
    package_info = package_member(package, ".PKGINFO", "controller metadata")
    try:
        fields: dict[str, list[str]] = {}
        for line in package_info.decode("utf-8").splitlines():
            if " = " in line:
                key, value = line.split(" = ", 1)
                fields.setdefault(key, []).append(value)
        name, version, architecture = (
            fields[key][0] for key in ("pkgname", "pkgver", "arch")
        )
    except (UnicodeDecodeError, KeyError, IndexError):
        fail("invalid controller package metadata")
    if (
        any(len(fields[key]) != 1 for key in ("pkgname", "pkgver", "arch"))
        or name != "pt31553-fan-control"
        or architecture != "x86_64"
        or not SAFE_IDENTITY.fullmatch(version)
    ):
        fail("invalid controller package identity")
    if package_member(
        package,
        "usr/lib/pt31553-fan-control/compatibility.toml",
        "compatibility declaration",
    ) != compatibility:
        fail("controller package has the wrong compatibility declaration")
    source_bytes = package_member(
        package,
        "usr/share/pt31553-fan-control/source-commit",
        "source commit",
    )
    try:
        source_commit = source_bytes.decode("ascii").removesuffix("\n")
    except UnicodeDecodeError:
        fail("invalid packaged controller source commit")
    if (
        source_bytes != f"{source_commit}\n".encode()
        or not HEX40.fullmatch(source_commit)
        or source_commit in {"0" * 40, "f" * 40}
    ):
        fail("invalid packaged controller source commit")
    run_tool("pacman-key", "--verify", str(signature), str(package))
    status_output = run_tool(
        "gpg",
        "--batch",
        "--no-options",
        "--homedir",
        "/etc/pacman.d/gnupg",
        "--status-fd",
        "1",
        "--verify",
        str(signature),
        str(package),
    )
    fingerprints = []
    for line in status_output.decode("ascii", errors="strict").splitlines():
        status_fields = line.split()
        if len(status_fields) >= 3 and status_fields[:2] == ["[GNUPG:]", "VALIDSIG"]:
            values = [
                value
                for value in status_fields[2:]
                if OPENPGP_FINGERPRINT.fullmatch(value)
            ]
            if values:
                fingerprints.append(values[-1])
    if len(fingerprints) != 1 or fingerprints[0] != expected_signer:
        fail("controller package signer mismatch")
    return name, version, architecture, source_commit


def load_provenance(path: pathlib.Path) -> dict:
    try:
        value = json.loads(regular_bytes(path, "package provenance", 16 * 1024 * 1024))
    except (UnicodeDecodeError, json.JSONDecodeError):
        fail("invalid package provenance JSON")
    root = exact_keys(value, {"schema_version", "candidate", "build", "kernel", "modules", "packages"}, "package provenance")
    if root["schema_version"] != 1 or root["candidate"] != EXPECTED_CANDIDATE:
        fail("package provenance identifies a different candidate")
    build = exact_keys(root["build"], {
        "source_commit", "source_lock_sha256", "build_environment_sha256",
        "build_attestation_sha256", "pkgbuild_sha256",
        "package_set_srcinfo_sha256", "package_manifest_signature_sha256",
        "package_manifest_signer_fingerprint",
    }, "package provenance build")
    if build["source_commit"] != "7a84732fd5e4350c1312fd0ed0c72ffa139fb766":
        fail("package provenance has the wrong kernel source commit")
    for field in set(build) - {"source_commit"}:
        hash_value(build[field], f"build.{field}")
    kernel = exact_keys(root["kernel"], {
        "release", "package", "image_path", "image_sha256",
        "image_signer_fingerprint", "config_path", "config_sha256",
        "module_trust_certificate_path", "module_trust_certificate_fingerprint",
    }, "package provenance kernel")
    expected_kernel = {
        "release": "7.1.8-cachyos-pt31553",
        "package": EXPECTED_PACKAGES[0],
        "image_path": "/usr/lib/modules/7.1.8-cachyos-pt31553/vmlinuz",
        "config_path": "/usr/lib/modules/7.1.8-cachyos-pt31553/build/.config",
        "module_trust_certificate_path": "/usr/lib/modules/7.1.8-cachyos-pt31553/build/certs/signing_key.x509",
    }
    if any(kernel[field] != expected for field, expected in expected_kernel.items()):
        fail("package provenance has the wrong kernel identity")
    for field in ("image_sha256", "image_signer_fingerprint", "config_sha256", "module_trust_certificate_fingerprint"):
        hash_value(kernel[field], f"kernel.{field}")
    modules = root["modules"]
    if not isinstance(modules, list) or len(modules) != 6:
        fail("package provenance must contain exactly six modules")
    for index, (module, expected) in enumerate(zip(modules, EXPECTED_MODULES, strict=True)):
        exact_keys(module, {"name", "path", "sha256", "signer_fingerprint", "vermagic", "provenance", "package", "source"}, f"module {index}")
        name, path, provenance_kind, package, source = expected
        if (
            module["name"] != name
            or module["path"] != path
            or module["vermagic"] != "7.1.8-cachyos-pt31553 SMP preempt mod_unload"
            or module["provenance"] != provenance_kind
            or module["package"] != package
            or module["source"] != source
        ):
            fail(f"module {index} identity mismatch")
        hash_value(module["sha256"], f"module {index} SHA-256")
        hash_value(module["signer_fingerprint"], f"module {index} signer")
    acer = modules[0]
    if any(module["signer_fingerprint"] != acer["signer_fingerprint"] for module in modules):
        fail("module signer identities are incoherent")
    if kernel["module_trust_certificate_fingerprint"] != acer["signer_fingerprint"]:
        fail("kernel module trust identity is incoherent")
    signers = {
        build["package_manifest_signer_fingerprint"],
        kernel["image_signer_fingerprint"],
        acer["signer_fingerprint"],
    }
    if len(signers) != 3:
        fail("package, module, and kernel image signers must be distinct")
    packages = root["packages"]
    if not isinstance(packages, list) or len(packages) != 3:
        fail("package provenance must contain exactly three packages")
    for package, expected_name in zip(packages, EXPECTED_PACKAGES, strict=True):
        exact_keys(package, {"name", "version", "architecture", "sha256"}, "package identity")
        if package["name"] != expected_name or package["version"] != "7.1.8-1" or package["architecture"] != "x86_64":
            fail("package-set identity mismatch")
        hash_value(package["sha256"], f"package {expected_name} SHA-256")
    return root


def load_template(root: pathlib.Path) -> dict:
    try:
        value = tomllib.loads(regular_bytes(root / "compatibility/pt315-53.toml", "compatibility template").decode())
    except (UnicodeDecodeError, tomllib.TOMLDecodeError):
        fail("invalid compatibility template")
    exact_keys(value, {"schema_version", "hardware", "kernel", "module", "secure_boot", "fan_control"}, "compatibility template")
    if value["schema_version"] != 1:
        fail("unsupported compatibility template")
    return value


def toml_string(value: str) -> str:
    return json.dumps(value, ensure_ascii=True)


def compatibility_text(template: dict, provenance: dict) -> str:
    kernel = provenance["kernel"]
    acer = provenance["modules"][0]
    hardware = template["hardware"]
    fan = template["fan_control"]
    forbidden = ",\n  ".join(toml_string(item) for item in fan["forbidden_capabilities"])
    endpoints = ", ".join(toml_string(item) for item in fan["endpoints"])
    return f'''# Generated from verified package provenance. Candidate identity only.
# QUALIFICATION STATUS: UNQUALIFIED. This file is not runtime authority.

schema_version = 1

[hardware]
dmi_product_name = {toml_string(hardware["dmi_product_name"])}
dmi_board_name = {toml_string(hardware["dmi_board_name"])}
bios_version = {toml_string(hardware["bios_version"])}

[kernel]
release = {toml_string(kernel["release"])}
package = {toml_string(kernel["package"])}
source_commit = {toml_string(provenance["build"]["source_commit"])}
image_sha256 = {toml_string(kernel["image_sha256"])}
image_signer_fingerprint = {toml_string(kernel["image_signer_fingerprint"])}

[module]
name = {toml_string(acer["name"])}
path = {toml_string(acer["path"])}
sha256 = {toml_string(acer["sha256"])}
signer_fingerprint = {toml_string(acer["signer_fingerprint"])}
vermagic = {toml_string(acer["vermagic"])}
provenance = {toml_string(acer["provenance"])}

[secure_boot]
required = true

[fan_control]
backend = {toml_string(fan["backend"])}
hwmon_name = {toml_string(fan["hwmon_name"])}
endpoints = [{endpoints}]
forbidden_capabilities = [
  {forbidden},
]
'''


def publish(path: pathlib.Path, content: bytes) -> None:
    if not path.name or path.name in {".", ".."}:
        fail("output must name a new file")
    try:
        directory = os.open(
            path.parent,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
        )
    except OSError:
        fail("output parent must be an existing non-symlink directory")
    temporary = f".{path.name}.tmp-{secrets.token_hex(16)}"
    descriptor = -1
    published = False
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory,
        )
        with os.fdopen(descriptor, "wb", closefd=False) as output:
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
        os.fchmod(descriptor, 0o444)
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.link(
            temporary,
            path.name,
            src_dir_fd=directory,
            dst_dir_fd=directory,
            follow_symlinks=False,
        )
        published = True
        os.unlink(temporary, dir_fd=directory)
        os.fsync(directory)
    except FileExistsError:
        fail("output must be a new file in an existing directory")
    except OSError:
        if published:
            try:
                os.unlink(path.name, dir_fd=directory)
                os.fsync(directory)
            except OSError:
                pass
        fail("atomic candidate declaration publication failed")
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary, dir_fd=directory)
        except FileNotFoundError:
            pass
        os.close(directory)


def compatibility(args: argparse.Namespace, root: pathlib.Path) -> None:
    provenance = load_provenance(args.provenance)
    text = compatibility_text(load_template(root), provenance)
    try:
        tomllib.loads(text)
    except tomllib.TOMLDecodeError:
        fail("generated compatibility declaration is invalid")
    publish(args.output, text.encode())


def manifest(args: argparse.Namespace, root: pathlib.Path) -> None:
    with tempfile.TemporaryDirectory(prefix="pt31553-candidate-") as temporary:
        snapshot_directory = pathlib.Path(temporary)
        provenance_path, provenance_bytes = snapshot(
            args.provenance, "package provenance", snapshot_directory, 16 * 1024 * 1024
        )
        compatibility_path, compatibility_bytes = snapshot(
            args.compatibility, "generated compatibility", snapshot_directory, 1024 * 1024
        )
        package_path, package_bytes = snapshot(
            args.controller_package, "controller package", snapshot_directory, 512 * 1024 * 1024
        )
        signature_path, signature_bytes = snapshot(
            args.controller_signature,
            "controller package signature",
            snapshot_directory,
            16 * 1024 * 1024,
        )
        manifest_signature_path, manifest_signature_bytes = snapshot(
            args.package_manifest_signature,
            "package-set manifest signature",
            snapshot_directory,
            16 * 1024 * 1024,
        )
        provenance = load_provenance(provenance_path)
        try:
            parsed_compatibility = tomllib.loads(compatibility_bytes.decode())
        except (UnicodeDecodeError, tomllib.TOMLDecodeError):
            fail("invalid generated compatibility")
        expected_compatibility = compatibility_text(load_template(root), provenance).encode()
        if compatibility_bytes != expected_compatibility:
            fail("compatibility declaration was not generated from this provenance")
        if parsed_compatibility["kernel"]["image_sha256"] != provenance["kernel"]["image_sha256"] or parsed_compatibility["module"]["sha256"] != provenance["modules"][0]["sha256"]:
            fail("generated compatibility does not match package provenance")
        controller_signer = openpgp_fingerprint(
            args.controller_signer_fingerprint, "controller signer fingerprint"
        )
        name, version, architecture, controller_source_commit = controller_metadata(
            package_path,
            signature_path,
            compatibility_bytes,
            controller_signer,
        )
        package_hash = hashlib.sha256(package_bytes).hexdigest()
        signature_hash = hashlib.sha256(signature_bytes).hexdigest()
        manifest_signature_hash = hashlib.sha256(manifest_signature_bytes).hexdigest()
        provenance_hash = hashlib.sha256(provenance_bytes).hexdigest()
    if manifest_signature_hash != provenance["build"]["package_manifest_signature_sha256"]:
        fail("package-set manifest signature does not match verified provenance")
    acer = provenance["modules"][0]
    value = {
        "schema_version": 1,
        "qualification_status": "unqualified",
        "candidate": provenance["candidate"],
        "controller": {
            "name": name,
            "version": version,
            "architecture": architecture,
            "source_commit": controller_source_commit,
            "package_sha256": package_hash,
            "signature_sha256": signature_hash,
            "signer_fingerprint": controller_signer,
            "compatibility_sha256": hashlib.sha256(compatibility_bytes).hexdigest(),
        },
        "kernel": {
            "release": provenance["kernel"]["release"],
            "source_commit": provenance["build"]["source_commit"],
            "image_sha256": provenance["kernel"]["image_sha256"],
            "image_signer_fingerprint": provenance["kernel"]["image_signer_fingerprint"],
            "module_sha256": acer["sha256"],
            "module_signer_fingerprint": acer["signer_fingerprint"],
        },
        "package_set": {
            "provenance_sha256": provenance_hash,
            "manifest_signature_sha256": manifest_signature_hash,
            "manifest_signer_fingerprint": provenance["build"]["package_manifest_signer_fingerprint"],
            "artifacts": provenance["packages"],
        },
        "installation": {
            "allowed_state": "disabled-only",
            "candidate_default": False,
            "recovery_kernel_package": "linux-cachyos-lts",
        },
    }
    publish(args.output, (json.dumps(value, indent=2, sort_keys=True) + "\n").encode())


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    compatibility_parser = subparsers.add_parser("compatibility")
    compatibility_parser.add_argument("--provenance", required=True, type=pathlib.Path)
    compatibility_parser.add_argument("--output", required=True, type=pathlib.Path)
    manifest_parser = subparsers.add_parser("manifest")
    manifest_parser.add_argument("--provenance", required=True, type=pathlib.Path)
    manifest_parser.add_argument("--compatibility", required=True, type=pathlib.Path)
    manifest_parser.add_argument("--controller-package", required=True, type=pathlib.Path)
    manifest_parser.add_argument("--controller-signature", required=True, type=pathlib.Path)
    manifest_parser.add_argument("--controller-signer-fingerprint", required=True)
    manifest_parser.add_argument("--package-manifest-signature", required=True, type=pathlib.Path)
    manifest_parser.add_argument("--output", required=True, type=pathlib.Path)
    args = parser.parse_args()
    root = pathlib.Path(__file__).resolve().parent.parent
    if args.command == "compatibility":
        compatibility(args, root)
    else:
        manifest(args, root)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (DeclarationError, KeyError, TypeError, IndexError, AttributeError, ValueError) as error:
        message = str(error) if str(error) else "malformed candidate input"
        print(f"generate-candidate-declarations: {message}", file=sys.stderr)
        raise SystemExit(1)
